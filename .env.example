# ==========================================
# Cinematic Portfolio & Admin Studio Configuration
# ==========================================

# Administrator Credentials
# (Optional: set strong administrator credentials or use "npm run admin:setup")
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here

# JWT Authentication Secret
# (Generate a 32+ character random secret for production)
JWT_SECRET=your_jwt_signing_secret_min_32_characters_here

# Allowed Frontend Origins for CORS (comma-separated, optional)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Port (for standalone production server: npm start)
PORT=3000

# Node Environment (development | production)
NODE_ENV=development
